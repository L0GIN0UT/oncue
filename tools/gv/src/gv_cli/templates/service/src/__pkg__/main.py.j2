"""Сборка сервиса: что входит в {{ s.name }} и как это связано (composition root)."""

from __future__ import annotations

{% if s.database %}
from pathlib import Path

{% endif %}
from gv_service import ServiceDefinition, main

from {{ s.package }}.api import build_routers
{% if s.database %}
from {{ s.package }}.infrastructure.db.tables import TABLES
from {{ s.package }}.infrastructure.messaging import CONSUMED_TOPICS, build_event_handlers
{% endif %}
from {{ s.package }}.settings import Settings

DEFINITION = ServiceDefinition(
    name="{{ s.name }}",
    settings_cls=Settings,
    description=(
        "{{ s.description | wordwrap(70, wrapstring=' "\n        "') }}"
    ),
{% if s.database %}
    tables=TABLES,
    migrations_path=Path(__file__).parent / "infrastructure" / "db" / "migrations",
    build_event_handlers=build_event_handlers,
    consumer_topics=CONSUMED_TOPICS,
{% endif %}
    build_routers=build_routers,
)


def run() -> None:
    """Консольная точка входа."""
    main(DEFINITION)
