[project]
name = "{{ s.distribution }}"
version = "0.1.0"
description = "{{ s.description }}"
requires-python = ">=3.13"
dependencies = ["gv-core", "gv-db", "gv-messaging", "gv-service", "gv-auth"]

[project.scripts]
{{ s.name }} = "{{ s.package }}.main:run"

[build-system]
requires = ["hatchling>=1.25"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ s.package }}"]
