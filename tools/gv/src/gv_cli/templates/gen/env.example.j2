# СГЕНЕРИРОВАНО `gv gen` из infra/services.toml — не редактировать вручную.
# Скопируйте в infra/compose/.env и задайте значения. Файл .env в git не коммитится.
# Сгенерировать пароли: `gv dev secrets` (выведет готовый .env со случайными значениями).

GV_ENVIRONMENT=local
GV_LOG_LEVEL=INFO
GV_REGISTRY=guessverse
GV_TAG=local
# Пусто — трейсинг выключен. С observability-стеком: http://otel-collector:4318
GV_OTLP_ENDPOINT=

POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=guessverse
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=guessverse
MINIO_ROOT_PASSWORD=
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=
UNLEASH_ADMIN_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Подписанные ссылки на ассеты (ADR 0012): ОДНО значение для gateway и media-pipeline,
# не короче 32 символов. `gv dev secrets` подставит его в обе переменные.
GV_MEDIA_SIGNING_SECRET=
GV_MEDIA__SIGNING_SECRET=
GV_MEDIA_ASSETS_BUCKET=gv-assets

# Админка: ключ Django и разрешённые сети (вне local/ci обязателен явный список CIDR)
GV_ADMIN__SECRET_KEY=
GV_ADMIN__IP_ALLOWLIST=

# Сервисные токены (D13, ADR 0016): секрет на каждого клиента, identity хранит только sha256.
# `gv dev secrets` генерирует секреты и подставляет их sha256 в GV_SERVICE_CLIENTS.
{% for client_id in service_clients %}
{{ service_secret_env(client_id) }}=
{% endfor %}
GV_SERVICE_CLIENTS={{ service_clients_json }}

# Пароли БД сервисов
PG_PASSWORD_UNLEASH=
{% for s in services if s.database %}
{{ s.db_password_env }}=
{% endfor %}
