# СГЕНЕРИРОВАНО `gv gen` из infra/services.toml — не редактировать вручную.
# Скопируйте в infra/compose/.env и задайте значения. Файл .env в git не коммитится.
# Сгенерировать пароли: `gv dev secrets` (выведет готовый .env со случайными значениями).

GV_ENVIRONMENT=local
GV_LOG_LEVEL=INFO
GV_REGISTRY=guessverse
GV_TAG=local
# Пусто — трейсинг выключен. С observability-стеком: http://otel-collector:4318
GV_OTLP_ENDPOINT=
# Origin веб-клиента (JSON-массив): мутации с cookie-аутентификацией (identity, game,
# collections, library, match, progression)
# принимаются только с них (CSRF). Пусто — такие мутации отклоняются.
GV_PUBLIC_ORIGINS=["https://localhost"]

POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=guessverse
RABBITMQ_PASSWORD=
# Ключи S3 (SeaweedFS): `gv dev secrets` генерирует оба значения.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Centrifugo (infra/centrifugo/config.json, D9 этапа 4). API-ключ server API получают только
# публикующие сервисы ({{ realtime_publishers | sort | join(", ") }}).
# Два РАЗНЫХ секрета: connection-токены подписывает identity, subscription-токены каналов
# комнат — match; компрометация match не даёт подделать вход в Centrifugo.
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=
CENTRIFUGO_SUBSCRIPTION_HMAC_SECRET=
# Origin веб-клиента для WebSocket/HTTP-stream Centrifugo (через пробел): чужой Origin
# получает отказ в соединении (защита от cross-site WebSocket hijacking).
CENTRIFUGO_ALLOWED_ORIGINS=https://localhost
UNLEASH_ADMIN_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Подписанные ссылки на ассеты (ADR 0012): ОДНО значение для gateway и media-pipeline,
# не короче 32 символов. `gv dev secrets` подставит его в обе переменные.
GV_MEDIA_SIGNING_SECRET=
GV_MEDIA__SIGNING_SECRET=

# Bootstrap-админ для автосидинга e2e (ТОЛЬКО local/ci): команда `migrate` identity
# идемпотентно создаёт этого админа, а `gv dev seed` входит им и грузит каталог/медиа.
# Вне local/ci заданные значения — ошибка старта identity (админ в проде не создаётся).
# Пароль генерирует `gv dev secrets`; логин — служебный адрес в домене `.example`
# (RFC 2606: зарезервирован под примеры, не маршрутизируется). Не использовать `.local`
# или `.test` — их отклоняет email_validator (identity при старте упадёт на валидации).
GV_BOOTSTRAP_ADMIN__LOGIN=seed-admin@guessverse.example
GV_BOOTSTRAP_ADMIN__PASSWORD=
GV_MEDIA_ASSETS_BUCKET=gv-assets
GV_COSMETICS_BUCKET=gv-cosmetics

# Лимиты gateway по IP (rate: `40r/s`, `60r/m`; burst — число). Дефолты закрыты в
# compose.gateway.yml; за одним NAT (e2e: шесть браузеров с одного адреса) поднимать.
GV_GATEWAY_API_RATE=40r/s
GV_GATEWAY_API_BURST=80
GV_GATEWAY_AUTH_RATE=60r/m
GV_GATEWAY_AUTH_BURST=20
# Публичный адрес сайта: ссылки отписки в письмах notifications (без завершающего /).
GV_PUBLIC_BASE_URL=https://localhost
# progression: ключ HMAC промокодов (ADR 0048, не короче 32 символов); `gv dev secrets` генерирует.
GV_PROGRESSION__PROMO_HMAC_KEY=
# notifications: срок жизни ссылки отписки из письма, дней (токен непрозрачный, ключа HMAC нет).
GV_NOTIFICATIONS__UNSUBSCRIBE_TTL_DAYS=90

# Ключи подписи JWT identity: JSON [{"kid","private_pem","active"}] (Ed25519 или P-256).
# `gv dev secrets` генерирует один Ed25519-ключ; пусто — временный ключ (только local/ci).
GV_JWT__SIGNING_KEYS=

# Коды из писем (ADR 0041). Локально и в CI — backend=log: код пишется в лог identity
# (e2e читает его оттуда). В production — backend=smtp; `log` вне local/ci — ошибка старта.
GV_EMAIL__BACKEND=log
# Ключ HMAC кодов: `gv dev secrets` генерирует случайный; обязателен вне local/ci.
GV_EMAIL_CODE__HMAC_KEY=
# SMTP (при backend=smtp). Порт 465 — GV_SMTP__USE_TLS=true и GV_SMTP__START_TLS=false.
# Логин и пароль задаёт оператор вручную: `gv dev secrets` их не заполняет.
GV_SMTP__HOST=localhost
GV_SMTP__PORT=587
GV_SMTP__USERNAME=
GV_SMTP__PASSWORD=

# Контент этапа 3a (значения по умолчанию сервисов; план этапа 3a §2.7).
# media-pipeline: лимит динамических профилей (ADR 0025), порция досоздания наборов,
# пауза очистки журнала выдачи ссылок (задача media.link_issuance.purge).
GV_MEDIA__MAX_DYNAMIC_PROFILES=50
GV_MEDIA__BACKFILL_BATCH=200
GV_MEDIA__LINK_PURGE_INTERVAL_S=600
# catalog: кадры TMDB на фильм, порция переопубликации, тексты загадок файлового засева
# сразу одобрены (ТОЛЬКО local/ci: вне них catalog не стартует с true, ADR 0024).
GV_CATALOG__TMDB_FRAMES_MAX=6
GV_CATALOG__REPUBLISH_BATCH=200
GV_CATALOG__SEED_TEXTS_APPROVED=true

# Секрет детерминированного розыгрыша наборов дня game (не короче 32 символов).
GV_GAME__DAILY_SEED_SECRET=
# game, этап 3a: лимиты в минуту на субъекта — свежая ссылка ревила (D13) и поиск
# персон марафона (D14).
GV_GAME_LIMITS__FINAL_CLUE_PER_MIN=30
GV_GAME_LIMITS__SUBJECTS_PER_MIN=60
# game, этап 3b: проверка играбельности черновика сборника (POST /v1/modes/{key}/playability).
GV_GAME_LIMITS__PLAYABILITY_PER_MIN=30

# Сборники и медиатека, этап 3b (план этапа 3b §2.8, ADR 0028–0031; значения — умолчания
# сервисов). collections: черновиков на автора, публикаций в сутки (fail-closed), единиц
# в сборнике, тегов; сложность = 1 − байесовское среднее доли очков (prior, вес m), до
# min_plays завершений — null; границы корзин easy/medium/hard — JSON-массив.
GV_COLLECTIONS__LIMITS__DRAFTS_MAX=20
GV_COLLECTIONS__LIMITS__PUBLISH_PER_DAY=5
GV_COLLECTIONS__LIMITS__ITEMS_MIN=5
GV_COLLECTIONS__LIMITS__ITEMS_MAX=200
GV_COLLECTIONS__LIMITS__TAGS_MAX=5
GV_COLLECTIONS__DIFFICULTY__PRIOR=0.5
GV_COLLECTIONS__DIFFICULTY__M=10
GV_COLLECTIONS__DIFFICULTY__MIN_PLAYS=10
GV_COLLECTIONS__DIFFICULTY__THRESHOLDS=[0.4,0.7]
# library: YAML системных полок (пусто — встроенный), своих полок на пользователя,
# сохранений в минуту.
GV_LIBRARY__SHELVES_CONFIG=
GV_LIBRARY__LIMITS__CUSTOM_SHELVES_MAX=50
GV_LIBRARY__LIMITS__SAVES_PER_MIN=60
# Свой denylist UGC для collections и library (пусто — встроенный gv_text, ADR 0030).
GV_UGC__DENYLIST_PATH=

# Админка: ключ Django и разрешённые сети (вне local/ci обязателен явный список CIDR)
GV_ADMIN__SECRET_KEY=
GV_ADMIN__IP_ALLOWLIST=

# Сервисные токены (D13, ADR 0016): секрет на каждого клиента, identity хранит только sha256.
# `gv dev secrets` генерирует секреты и подставляет их sha256 в GV_SERVICE_CLIENTS.
{% for client_id in service_clients %}
{{ service_secret_env(client_id) }}=
{% endfor %}
GV_SERVICE_CLIENTS={{ service_clients_json }}
# Лимиты выдачи сервисных токенов в минуту: неудачи — на пару (client_id, IP), успехи — на
# client_id. Заменили единый GV_SERVICE_TOKEN_LIMIT__PER_CLIENT_PER_MIN — при обновлении
# окружения удалите старую переменную.
GV_SERVICE_TOKEN_LIMIT__FAILURES_PER_CLIENT_IP_PER_MIN=30
GV_SERVICE_TOKEN_LIMIT__SUCCESS_PER_CLIENT_PER_MIN=600

# Пароли БД сервисов
PG_PASSWORD_UNLEASH=
{% for s in services if s.database %}
{{ s.db_password_env }}=
{% endfor %}
