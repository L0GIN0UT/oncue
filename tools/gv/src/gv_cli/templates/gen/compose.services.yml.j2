# СГЕНЕРИРОВАНО `gv gen` из infra/services.toml — не редактировать вручную.
# Запуск: см. infra/compose/README.md

x-python-service: &python-service
  build:
    context: ../..
    dockerfile: infra/docker/python-service.Dockerfile
  restart: unless-stopped
  stop_grace_period: 30s
  networks: [backend]
  logging:
    driver: json-file
    options: {max-size: "20m", max-file: "5"}
  healthcheck:
    test: ["CMD", "python", "-c", "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3).status == 200 else 1)"]
    interval: 10s
    timeout: 5s
    retries: 6
    start_period: 20s

x-common-env: &common-env
  GV_ENVIRONMENT: ${GV_ENVIRONMENT:?задайте GV_ENVIRONMENT (local|staging|production)}
  GV_LOG_LEVEL: ${GV_LOG_LEVEL:-INFO}
  GV_OTLP_ENDPOINT: ${GV_OTLP_ENDPOINT:-}
  GV_JWKS_URL: http://identity:8000/.well-known/jwks.json
  GV_JWT_ISSUER: ${GV_JWT_ISSUER:-https://identity.guessverse.local}

services:
{% for s in services %}
  # ---------------------------------------------------------------- {{ s.name }}
  # {{ s.description }}
{% if s.database %}
  {{ s.dns }}-migrate:
    <<: *python-service
    build:
      context: ../..
      dockerfile: infra/docker/python-service.Dockerfile
      args: {SERVICE: {{ s.name }}, APT_PACKAGES: "{{ s.apt_packages }}"}
    image: ${GV_REGISTRY:-guessverse}/{{ s.dns }}:${GV_TAG:-local}
    command: ["migrate"]
    restart: "no"
    healthcheck: {disable: true}
    environment:
      <<: *common-env
      GV_SERVICE_NAME: {{ s.name }}
      GV_DATABASE_URL: postgresql+asyncpg://{{ s.name }}:${ {{- s.db_password_env }}:?задайте {{ s.db_password_env }}}@postgres:5432/{{ s.name }}
{% if s.s3 %}
      GV_S3__ENDPOINT: http://s3:9000
      GV_S3__ACCESS_KEY: ${S3_ACCESS_KEY:?задайте S3_ACCESS_KEY}
      GV_S3__SECRET_KEY: ${S3_SECRET_KEY:?задайте S3_SECRET_KEY}
{% endif %}
{% if s.name == "progression" %}
      # Job migrate создаёт бакет косметики и проверяет ключ промокодов (prepare_resources).
      GV_PROGRESSION__PROMO_HMAC_KEY: ${GV_PROGRESSION__PROMO_HMAC_KEY:?задайте GV_PROGRESSION__PROMO_HMAC_KEY}
      GV_PROGRESSION__COSMETICS_BUCKET: ${GV_COSMETICS_BUCKET:-gv-cosmetics}
{% endif %}
    depends_on:
      postgres: {condition: service_healthy}
{% if s.s3 %}
      s3: {condition: service_healthy}
{% endif %}
    deploy:
      resources:
        limits: {memory: 256M}
{% endif %}

  {{ s.dns }}:
    <<: *python-service
    build:
      context: ../..
      dockerfile: infra/docker/python-service.Dockerfile
      args: {SERVICE: {{ s.name }}, APT_PACKAGES: "{{ s.apt_packages }}"}
    image: ${GV_REGISTRY:-guessverse}/{{ s.dns }}:${GV_TAG:-local}
    command: ["all"]
    environment:
      <<: *common-env
      GV_SERVICE_NAME: {{ s.name }}
{% if s.database %}
      GV_DATABASE_URL: postgresql+asyncpg://{{ s.name }}:${ {{- s.db_password_env }}:?задайте {{ s.db_password_env }}}@postgres:5432/{{ s.name }}
      GV_DATABASE_POOL_SIZE: "5"
{% endif %}
{% if s.redis %}
      GV_REDIS_URL: redis://:${REDIS_PASSWORD:?задайте REDIS_PASSWORD}@redis:6379/0
{% endif %}
{% if s.kafka %}
      GV_KAFKA_BOOTSTRAP: redpanda:9092
{% endif %}
{% if s.rabbitmq %}
      GV_RABBITMQ_URL: amqp://${RABBITMQ_USER:-guessverse}:${RABBITMQ_PASSWORD:?задайте RABBITMQ_PASSWORD}@rabbitmq:5672/
{% endif %}
{% if s.s3 %}
      GV_S3__ENDPOINT: http://s3:9000
      GV_S3__ACCESS_KEY: ${S3_ACCESS_KEY:?задайте S3_ACCESS_KEY}
      GV_S3__SECRET_KEY: ${S3_SECRET_KEY:?задайте S3_SECRET_KEY}
{% endif %}
{% if s.realtime %}
{% if s.name in realtime_publishers %}
      # Centrifugo (D9 этапа 4): server API для публикаций — только публикующим сервисам.
      GV_REALTIME__API_URL: http://centrifugo:8000/api
      GV_REALTIME__API_KEY: ${CENTRIFUGO_API_KEY:?задайте CENTRIFUGO_API_KEY}
{% endif %}
      # Секрет токенов Centrifugo — свой у каждого сервиса (D9).
{% if s.name in realtime_token_secrets %}
      {{ realtime_token_secrets[s.name][0] }}: ${ {{- realtime_token_secrets[s.name][1] }}:?задайте {{ realtime_token_secrets[s.name][1] }}}
{% endif %}
{% endif %}
{% if s.name in cookie_mutation_services %}
      GV_PUBLIC_ORIGINS: ${GV_PUBLIC_ORIGINS:?задайте GV_PUBLIC_ORIGINS}
{% endif %}
{% if s.name == "identity" %}
      GV_SERVICE_CLIENTS: ${GV_SERVICE_CLIENTS:-[]}
      # Лимиты выдачи сервисных токенов (умолчания identity; заменили PER_CLIENT_PER_MIN).
      GV_SERVICE_TOKEN_LIMIT__FAILURES_PER_CLIENT_IP_PER_MIN: ${GV_SERVICE_TOKEN_LIMIT__FAILURES_PER_CLIENT_IP_PER_MIN:-30}
      GV_SERVICE_TOKEN_LIMIT__SUCCESS_PER_CLIENT_PER_MIN: ${GV_SERVICE_TOKEN_LIMIT__SUCCESS_PER_CLIENT_PER_MIN:-600}
      # Пусто — временный ключ (только local/ci); вне них identity не стартует без ключей.
      GV_JWT__SIGNING_KEYS: ${GV_JWT__SIGNING_KEYS:-}
      # Коды из писем (ADR 0041): вне local/ci backend=smtp и ключ HMAC обязательны.
      GV_EMAIL__BACKEND: ${GV_EMAIL__BACKEND:-smtp}
      GV_EMAIL__SENDER: ${GV_EMAIL__SENDER:-Guessverse <no-reply@guessverse.local>}
      GV_EMAIL_CODE__HMAC_KEY: ${GV_EMAIL_CODE__HMAC_KEY:?задайте GV_EMAIL_CODE__HMAC_KEY}
      GV_SMTP__HOST: ${GV_SMTP__HOST:-localhost}
      GV_SMTP__PORT: ${GV_SMTP__PORT:-587}
      GV_SMTP__USERNAME: ${GV_SMTP__USERNAME:-}
      GV_SMTP__PASSWORD: ${GV_SMTP__PASSWORD:-}
      GV_SMTP__START_TLS: ${GV_SMTP__START_TLS:-true}
      GV_SMTP__USE_TLS: ${GV_SMTP__USE_TLS:-false}
      GV_SMTP__TIMEOUT_S: ${GV_SMTP__TIMEOUT_S:-10}
{% endif %}
{% if s.name == "media_pipeline" %}
      GV_MEDIA__SIGNING_SECRET: ${GV_MEDIA__SIGNING_SECRET:?задайте GV_MEDIA__SIGNING_SECRET}
      GV_MEDIA__MAX_DYNAMIC_PROFILES: ${GV_MEDIA__MAX_DYNAMIC_PROFILES:-50}
      GV_MEDIA__BACKFILL_BATCH: ${GV_MEDIA__BACKFILL_BATCH:-200}
      GV_MEDIA__LINK_PURGE_INTERVAL_S: ${GV_MEDIA__LINK_PURGE_INTERVAL_S:-600}
{% endif %}
{% if s.name == "catalog" %}
      GV_CATALOG__TMDB_FRAMES_MAX: ${GV_CATALOG__TMDB_FRAMES_MAX:-6}
      GV_CATALOG__REPUBLISH_BATCH: ${GV_CATALOG__REPUBLISH_BATCH:-200}
      # Только local/ci: вне них catalog отказывается стартовать с true.
      GV_CATALOG__SEED_TEXTS_APPROVED: ${GV_CATALOG__SEED_TEXTS_APPROVED:-false}
{% endif %}
{% if s.name == "game" %}
      GV_GAME__DAILY_SEED_SECRET: ${GV_GAME__DAILY_SEED_SECRET:?задайте GV_GAME__DAILY_SEED_SECRET}
{% for m in services if m.name == "media_pipeline" %}
      GV_GAME__MEDIA_URL: http://{{ m.dns }}:8000
{% endfor %}
{% endif %}
{% if s.name == "collections" %}
      GV_COLLECTIONS__LIMITS__DRAFTS_MAX: ${GV_COLLECTIONS__LIMITS__DRAFTS_MAX:-20}
      GV_COLLECTIONS__LIMITS__PUBLISH_PER_DAY: ${GV_COLLECTIONS__LIMITS__PUBLISH_PER_DAY:-5}
      GV_COLLECTIONS__LIMITS__ITEMS_MIN: ${GV_COLLECTIONS__LIMITS__ITEMS_MIN:-5}
      GV_COLLECTIONS__LIMITS__ITEMS_MAX: ${GV_COLLECTIONS__LIMITS__ITEMS_MAX:-200}
      GV_COLLECTIONS__LIMITS__TAGS_MAX: ${GV_COLLECTIONS__LIMITS__TAGS_MAX:-5}
      GV_COLLECTIONS__DIFFICULTY__PRIOR: ${GV_COLLECTIONS__DIFFICULTY__PRIOR:-0.5}
      GV_COLLECTIONS__DIFFICULTY__M: ${GV_COLLECTIONS__DIFFICULTY__M:-10}
      GV_COLLECTIONS__DIFFICULTY__MIN_PLAYS: ${GV_COLLECTIONS__DIFFICULTY__MIN_PLAYS:-10}
      GV_COLLECTIONS__DIFFICULTY__THRESHOLDS: ${GV_COLLECTIONS__DIFFICULTY__THRESHOLDS:-[0.4,0.7]}
{% endif %}
{% if s.name == "library" %}
      # Пусто — встроенный config/shelves.yaml; свой файл нужно смонтировать в контейнер.
      GV_LIBRARY__SHELVES_CONFIG: ${GV_LIBRARY__SHELVES_CONFIG:-}
      GV_LIBRARY__LIMITS__CUSTOM_SHELVES_MAX: ${GV_LIBRARY__LIMITS__CUSTOM_SHELVES_MAX:-50}
      GV_LIBRARY__LIMITS__SAVES_PER_MIN: ${GV_LIBRARY__LIMITS__SAVES_PER_MIN:-60}
{% endif %}
{% if s.name in ("collections", "library") %}
      # Пусто — встроенный denylist gv_text; свой файл нужно смонтировать в контейнер.
      GV_UGC__DENYLIST_PATH: ${GV_UGC__DENYLIST_PATH:-}
{% endif %}
{% if s.name == "game" %}
      GV_GAME_LIMITS__PLAYABILITY_PER_MIN: ${GV_GAME_LIMITS__PLAYABILITY_PER_MIN:-30}
{% endif %}
{% if s.name == "progression" %}
      # Ключ HMAC промокодов (ADR 0048): один на все процессы; вне local/ci без него миграция и API не стартуют.
      GV_PROGRESSION__PROMO_HMAC_KEY: ${GV_PROGRESSION__PROMO_HMAC_KEY:?задайте GV_PROGRESSION__PROMO_HMAC_KEY}
      # Бакет косметики с анонимным чтением префикса c/ (gateway отдаёт его по /cosmetics/).
      GV_PROGRESSION__COSMETICS_BUCKET: ${GV_COSMETICS_BUCKET:-gv-cosmetics}
      # Своя аватарка (ADR 0048): файл уходит в media-pipeline (internal, scope ugc.image);
      # одобренные изображения gateway отдаёт публично по /ugc/.
      GV_PROGRESSION__MEDIA_URL: ${GV_PROGRESSION__MEDIA_URL:-http://media-pipeline:8000}
      GV_PROGRESSION__UGC_BASE_URL: ${GV_PROGRESSION__UGC_BASE_URL:-/ugc/}
{% endif %}
{% if s.name == "notifications" %}
      # Токены отписки непрозрачные (в БД только sha256), ключа HMAC больше нет (ADR 0047, 0048).
      GV_NOTIFICATIONS__UNSUBSCRIBE_TTL_DAYS: ${GV_NOTIFICATIONS__UNSUBSCRIBE_TTL_DAYS:-90}
      GV_NOTIFICATIONS__PUBLIC_BASE_URL: ${GV_PUBLIC_BASE_URL:-https://localhost}
      GV_NOTIFICATIONS__EMAIL_BACKEND: ${GV_NOTIFICATIONS__EMAIL_BACKEND:-smtp}
      GV_NOTIFICATIONS__SMTP__HOST: ${GV_SMTP__HOST:-localhost}
      GV_NOTIFICATIONS__SMTP__PORT: ${GV_SMTP__PORT:-587}
      GV_NOTIFICATIONS__SMTP__SENDER: ${GV_EMAIL__SENDER:-Guessverse <no-reply@guessverse.local>}
      GV_NOTIFICATIONS__SMTP__USERNAME: ${GV_SMTP__USERNAME:-}
      GV_NOTIFICATIONS__SMTP__PASSWORD: ${GV_SMTP__PASSWORD:-}
      GV_NOTIFICATIONS__SMTP__START_TLS: ${GV_SMTP__START_TLS:-true}
      GV_NOTIFICATIONS__SMTP__USE_TLS: ${GV_SMTP__USE_TLS:-false}
      GV_NOTIFICATIONS__SMTP__TIMEOUT_S: ${GV_SMTP__TIMEOUT_S:-10}
{% endif %}
{% if s.name in service_clients %}
      GV_SERVICE_AUTH__TOKEN_URL: http://identity:8000/internal/v1/service-tokens
      GV_SERVICE_AUTH__CLIENT_ID: {{ s.name }}
      GV_SERVICE_AUTH__CLIENT_SECRET: ${ {{- service_secret_env(s.name) }}:?задайте {{ service_secret_env(s.name) }}}
{% endif %}
    depends_on:
{% if s.database %}
      {{ s.dns }}-migrate: {condition: service_completed_successfully}
{% endif %}
{% if s.redis %}
      redis: {condition: service_healthy}
{% endif %}
{% if s.kafka %}
      redpanda: {condition: service_healthy}
{% endif %}
{% if s.rabbitmq %}
      rabbitmq: {condition: service_healthy}
{% endif %}
{% if s.s3 %}
      s3: {condition: service_healthy}
{% endif %}
{% if not (s.database or s.redis or s.kafka or s.rabbitmq or s.s3) %}
      {}
{% endif %}
    deploy:
      resources:
        limits: {memory: {{ s.memory_mb }}M}
{% endfor %}
