# СГЕНЕРИРОВАНО `gv gen` из infra/services.toml — не редактировать вручную.
# Локальная разработка: порты сервисов на хосте и читаемые логи.
services:
{% for s in services %}
  {{ s.dns }}:
    ports: ["127.0.0.1:{{ s.dev_port }}:8000"]
    environment:
      GV_LOG_JSON: "false"
{% if s.name == "identity" %}
      # Ссылки из писем ведут на веб-клиент за локальным gateway.
      GV_EMAIL__VERIFY_LINK: https://localhost/verify-email?token={token}
      GV_EMAIL__RESET_LINK: https://localhost/reset-password?token={token}
{% endif %}
{% if s.name == "game" %}
      # Сиды режимов публикуются при старте (game.modes.bootstrap).
      GV_GAME__BOOTSTRAP_MODES_DIR: /seeds/game/modes
    volumes:
      - ../../seeds/game/modes:/seeds/game/modes:ro
{% endif %}
{% endfor %}
  # Bootstrap-админ автосидинга создаётся в job `migrate` identity (только local/ci).
  # Пусто (переменные не заданы) — функция выключена; значения берутся из .env.
  identity-migrate:
    environment:
      GV_BOOTSTRAP_ADMIN__LOGIN: ${GV_BOOTSTRAP_ADMIN__LOGIN:-}
      GV_BOOTSTRAP_ADMIN__PASSWORD: ${GV_BOOTSTRAP_ADMIN__PASSWORD:-}
