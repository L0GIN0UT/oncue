    },
    "from_user_id": {
      "format": "uuid",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "type": "string"
    },
    "to_user_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "at",
    "from_nickname",
    "from_user_id",
    "request_id",
    "to_user_id"
