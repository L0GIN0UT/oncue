{
  "$id": "urn:guessverse:contracts:events:media_pipeline:AssetsFailed:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Генерация набора ассетов не удалась.",
  "properties": {
    "asset_set_id": {
      "format": "uuid",
      "type": "string"
    },
    "attempts": {
      "minimum": 1,
      "type": "integer"
    },
    "clue_type": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "error_code": {
      "maxLength": 64,
      "type": "string"
    },
    "media_item_id": {
      "format": "uuid",
      "type": "string"
    },
    "profile_key": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "version": {
      "description": "Монотонная версия агрегата: потребитель отбрасывает событие с version не больше уже применённой",
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "asset_set_id",
    "media_item_id",
    "clue_type",
    "profile_key",
    "error_code",
    "retryable",
    "attempts",
    "version"
  ],
  "title": "media_pipeline.AssetsFailed v1",
  "type": "object",
  "x-aggregate-type": "asset_set",
  "x-topic": "media_pipeline.asset_set.v1"
}
