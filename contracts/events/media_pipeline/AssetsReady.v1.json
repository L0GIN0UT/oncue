{
  "$id": "urn:guessverse:contracts:events:media_pipeline:AssetsReady:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Набор ассетов загадки готов. aggregate_id конверта — media_item_id (порядок событий по единице).",
  "properties": {
    "asset_set_id": {
      "format": "uuid",
      "type": "string"
    },
    "clue_type": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "levels_count": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
    },
    "media_item_id": {
      "format": "uuid",
      "type": "string"
    },
    "params_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "profile_key": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "version": {
      "description": "Монотонная версия агрегата: потребитель отбрасывает событие с version не больше уже применённой",
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "asset_set_id",
    "media_item_id",
    "clue_type",
    "profile_key",
    "params_hash",
    "levels_count",
    "version"
  ],
  "title": "media_pipeline.AssetsReady v1",
  "type": "object",
  "x-aggregate-type": "asset_set",
  "x-topic": "media_pipeline.asset_set.v1"
}
