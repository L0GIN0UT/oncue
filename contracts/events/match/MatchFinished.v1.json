{
  "$id": "urn:guessverse:contracts:events:match:MatchFinished:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Матч завершён (в том числе досрочно: сдача, тех. победа, прерывание). aggregate_id — match_id. Пишется в одной транзакции с итогом в Postgres (ADR 0034); повтор после handoff не публикуется (UNIQUE match_id). Без ников и e-mail (ПДн).",
  "properties": {
    "abort_reason": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Машинная причина прерывания (match.pool_too_small, admin и т. п.)"
    },
    "aborted": {
      "description": "Матч прерван (админ, ошибка плана); рейтинг его не учитывает",
      "type": "boolean"
    },
    "collection_ids": {
      "description": "Сборники лобби (D12); пусто — не по сборнику",
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 10,
      "type": "array",
      "uniqueItems": true
    },
    "domain": {
      "enum": [
        "music",
        "film"
      ],
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "type": "string"
    },
    "format": {
      "description": "Вид сессии режима (session.kind)",
      "enum": [
        "duel",
        "party",
        "lobby"
      ],
      "type": "string"
    },
    "ladder": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Ladder рейтинга (только ranked, этап 4b)"
    },
    "match_id": {
      "format": "uuid",
      "type": "string"
    },
    "mode_key": {
      "maxLength": 100,
      "pattern": "^(music|film)\\.[a-z0-9_]+\\.[a-z0-9_]+$",
      "type": "string"
    },
    "mode_version": {
      "minimum": 1,
      "type": "integer"
    },
    "players": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "finish": {
            "description": "Как игрок закончил матч",
            "enum": [
              "completed",
              "forfeit",
              "left",
              "tech_win",
              "tech_loss"
            ],
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "enum": [
                  "win",
                  "loss",
                  "draw"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Исход дуэли; null в матче на 3+ игроков"
          },
          "place": {
            "description": "Место с ничьими (1, 1, 3)",
            "maximum": 6,
            "minimum": 1,
            "type": "integer"
          },
          "score": {
            "minimum": 0,
            "type": "integer"
          },
          "slot": {
            "description": "Место в комнате с 0",
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "user_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "slot",
          "score",
          "place",
          "outcome",
          "finish"
        ],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 2,
      "type": "array"
    },
    "ranked": {
      "type": "boolean"
    },
    "room_code": {
      "description": "Код комнаты (D12)",
      "pattern": "^[A-HJ-NP-Z2-9]{8}$",
      "type": "string"
    },
    "rounds": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "index": {
            "description": "Номер раунда с 0 (как game.GameFinished)",
            "maximum": 49,
            "minimum": 0,
            "type": "integer"
          },
          "media_item_id": {
            "format": "uuid",
            "type": "string"
          },
          "results": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "elapsed_ms": {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Время ответа от открытия уровня (сервер)"
                },
                "level": {
                  "anyOf": [
                    {
                      "maximum": 20,
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Уровень точного ответа; null — не угадал"
                },
                "partial": {
                  "description": "Засчитан частичный ответ",
                  "type": "boolean"
                },
                "score": {
                  "minimum": 0,
                  "type": "integer"
                },
                "user_id": {
                  "format": "uuid",
                  "type": "string"
                }
              },
              "required": [
                "user_id",
                "level",
                "partial",
                "score",
                "elapsed_ms"
              ],
              "type": "object"
            },
            "maxItems": 6,
            "type": "array"
          }
        },
        "required": [
          "index",
          "media_item_id",
          "results"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "description": "Версия комнаты на момент события (монотонна в пределах комнаты)",
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "match_id",
    "version",
    "room_code",
    "mode_key",
    "mode_version",
    "domain",
    "format",
    "ranked",
    "ladder",
    "players",
    "rounds",
    "collection_ids",
    "aborted",
    "abort_reason",
    "started_at",
    "finished_at"
  ],
  "title": "match.MatchFinished v1",
  "type": "object",
  "x-aggregate-type": "match",
  "x-topic": "match.match.v1"
}
