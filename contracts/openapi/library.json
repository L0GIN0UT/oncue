            "type": "string"
          },
          "shelf_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null у системной полки, ещё не созданной лениво",
            "title": "Shelf Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Название своей полки",
            "title": "Title"
          },
          "title_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ключ i18n системной полки",
            "title": "Title Key"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "ref",
          "kind",
          "domains",
          "items_count"
        ],
        "title": "ShelfOut",
        "type": "object"
      }
    }
