          "changed": {
            "title": "Changed",
            "type": "boolean"
          },
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "removed_from": {
            "description": "ref полок, откуда убрал exclusive_with",
            "items": {
              "type": "string"
            },
            "title": "Removed From",
            "type": "array"
          },
          "shelves": {
            "description": "ref полок с этой единицей",
            "items": {
              "type": "string"
            },
            "title": "Shelves",
            "type": "array"
          }
        },
        "required": [
          "media_item_id",
          "changed",
          "shelves"
        ],
        "title": "SaveResult",
        "type": "object"
      },
      "ServiceMeta": {
        "description": "Сведения о сервисе.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "status"
        ],
        "title": "ServiceMeta",
        "type": "object"
      },
      "ShelfItemOut": {
        "description": "Единица на полке: карточка из проекции catalog (без вызова catalog, D11).",
        "properties": {
          "added_at": {
            "format": "date-time",
            "title": "Added At",
            "type": "string"
          },
          "domain": {
            "enum": [
              "music",
              "film"
            ],
            "title": "Domain",
            "type": "string"
          },
          "kind": {
            "description": "track, film, series, anime",
            "title": "Kind",
            "type": "string"
          },
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "persons": {
            "description": "Исполнители или режиссёры",
            "items": {
              "type": "string"
            },
            "title": "Persons",
            "type": "array"
          },
          "source": {
            "enum": [
              "reveal",
              "results",
              "card",
              "collection",
              "library"
            ],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "description": "unavailable — единица заблокирована в catalog (остаётся на полке)",
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          }
        },
        "required": [
          "media_item_id",
          "domain",
          "kind",
          "title",
          "status",
          "source",
          "added_at"
        ],
        "title": "ShelfItemOut",
        "type": "object"
      },
      "ShelfItemsPage": {
        "description": "Единицы полки (новые сверху, keyset-курсор).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ShelfItemOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
