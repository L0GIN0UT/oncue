{
  "components": {
    "schemas": {
      "CreateShelfRequest": {
        "additionalProperties": false,
        "description": "Своя полка (≤ ``limits.custom_shelves_max``).",
        "properties": {
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "CreateShelfRequest",
        "type": "object"
      },
      "ItemShelvesOut": {
        "description": "На каких полках пользователя лежит единица (для кнопки «Сохранить»).",
        "properties": {
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "shelves": {
            "items": {
              "type": "string"
            },
            "title": "Shelves",
            "type": "array"
          }
        },
        "required": [
          "media_item_id",
          "shelves"
        ],
        "title": "ItemShelvesOut",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 Problem Details — тело любого ответа-ошибки сервиса (для OpenAPI).\n\nAttributes:\n    type: URN проблемы ``urn:guessverse:problem:<code>``.\n    title: Человекочитаемый заголовок.\n    status: HTTP-статус.\n    code: Машинный код ошибки — на него опираются клиенты.\n    detail: Пояснение.\n    correlation_id: Идентификатор цепочки запроса (для поиска в логах).\n    details: Безопасные для клиента подробности (``AppError.details``).\n    errors: Ошибки валидации полей запроса.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ошибки валидации: loc, msg, type",
            "title": "Errors"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RenameShelfRequest": {
        "additionalProperties": false,
        "description": "Переименовать свою полку.",
        "properties": {
          "title": {
            "maxLength": 200,
            "minLength": 1,
