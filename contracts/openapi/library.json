          }
        },
        "required": [
          "shelf",
          "items"
        ],
        "title": "ShelfItemsPage",
        "type": "object"
      },
      "ShelfOut": {
        "description": "Полка пользователя: системная (из конфига) или своя.",
        "properties": {
          "domains": {
            "items": {
              "enum": [
                "music",
                "film"
              ],
              "type": "string"
            },
            "title": "Domains",
            "type": "array"
          },
          "exclusive_with": {
            "description": "Ключи системных полок, откуда единица уходит",
            "items": {
              "type": "string"
            },
            "title": "Exclusive With",
            "type": "array"
          },
          "items_count": {
            "minimum": 0.0,
            "title": "Items Count",
            "type": "integer"
          },
          "key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ключ системной полки",
            "title": "Key"
          },
          "kind": {
            "enum": [
              "system",
              "custom"
            ],
            "title": "Kind",
            "type": "string"
          },
          "ref": {
            "description": "`system:<key>` или uuid своей полки",
