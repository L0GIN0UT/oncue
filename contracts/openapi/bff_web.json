                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Не реализовано"
          }
        },
        "summary": "Кто смотрит страницу",
        "tags": [
          "bff_web"
        ]
      }
    }
  }
}
