  "info": {
    "description": "Backend-for-frontend: агрегация данных под экраны веб-клиента",
    "title": "guessverse-bff_web",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/meta": {
      "get": {
        "operationId": "meta_v1_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceMeta"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Сведения о сервисе",
        "tags": [
          "bff_web"
        ]
      }
    },
    "/v1/pages/home": {
      "get": {
        "operationId": "home_page_v1_pages_home_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Не реализовано"
          }
        },
        "summary": "Главная: дейлики и режимы",
        "tags": [
          "bff_web"
        ]
      }
    },
    "/v1/pages/results/{session_id}": {
      "get": {
        "operationId": "results_page_v1_pages_results__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultsPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Не аутентифицирован"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Не найдено"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Некорректные данные"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Не реализовано"
          }
        },
        "summary": "Экран результатов сессии",
        "tags": [
          "bff_web"
        ]
      }
    },
    "/v1/pages/solo": {
      "get": {
        "operationId": "solo_page_v1_pages_solo_get",
        "parameters": [
          {
            "in": "query",
            "name": "domain",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "music",
                    "film"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Domain"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoloPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Некорректные данные"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Не реализовано"
          }
        },
        "summary": "Хаб соло-режимов",
        "tags": [
          "bff_web"
        ]
      }
    },
    "/v1/session": {
      "get": {
        "description": "Недействительный или истёкший токен — `subject: null`, а не ошибка.",
        "operationId": "session_v1_session_get",
        "responses": {
