{
  "components": {
    "schemas": {
      "AssetLinkRequest": {
        "description": "Запрос ссылки на уровень набора.",
        "properties": {
          "asset_set_id": {
            "format": "uuid",
            "title": "Asset Set Id",
            "type": "string"
          },
          "level": {
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Level",
            "type": "integer"
          },
          "subject": {
            "description": "Кто запрашивает (сессия игры, матч): ключ лимита выдачи. Сервис хранит только sha256-хэш значения",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\x21-\\x7e]+$",
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "asset_set_id",
          "level",
          "subject"
        ],
        "title": "AssetLinkRequest",
        "type": "object"
      },
      "AssetLinkResponse": {
        "description": "Подписанная ссылка.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "level": {
            "title": "Level",
            "type": "integer"
          },
          "mime": {
            "title": "Mime",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expires_at",
          "mime",
          "level"
        ],
        "title": "AssetLinkResponse",
        "type": "object"
      },
      "AssetSetItem": {
        "description": "Набор ассетов.",
        "properties": {
          "asset_set_id": {
            "format": "uuid",
            "title": "Asset Set Id",
            "type": "string"
          },
          "clue_type": {
            "title": "Clue Type",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "levels_count": {
            "title": "Levels Count",
            "type": "integer"
          },
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "params_hash": {
            "title": "Params Hash",
            "type": "string"
          },
          "profile_key": {
            "title": "Profile Key",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "asset_set_id",
          "media_item_id",
          "clue_type",
          "profile_key",
          "params_hash",
          "status",
          "levels_count",
          "generation",
          "error_code"
        ],
        "title": "AssetSetItem",
        "type": "object"
      },
      "Body_upload_source_admin_v1_sources_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "Файл исходника",
            "title": "File",
            "type": "string"
          },
          "kind": {
            "enum": [
              "audio",
              "frame",
              "poster",
              "soundtrack",
              "audio_clip"
            ],
            "title": "Kind",
            "type": "string"
          },
          "license_note": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License Note"
          },
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "origin": {
            "anyOf": [
              {
                "enum": [
                  "upload",
                  "seed",
                  "tmdb"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin"
          },
          "position": {
            "default": 1,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Position",
            "type": "integer"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          },
          "source_url": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "required": [
          "media_item_id",
          "kind",
          "reason",
          "file"
        ],
        "title": "Body_upload_source_admin_v1_sources_post",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 Problem Details — тело любого ответа-ошибки сервиса (для OpenAPI).\n\nAttributes:\n    type: URN проблемы ``urn:guessverse:problem:<code>``.\n    title: Человекочитаемый заголовок.\n    status: HTTP-статус.\n    code: Машинный код ошибки — на него опираются клиенты.\n    detail: Пояснение.\n    correlation_id: Идентификатор цепочки запроса (для поиска в логах).\n    details: Безопасные для клиента подробности (``AppError.details``).\n    errors: Ошибки валидации полей запроса.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ошибки валидации: loc, msg, type",
            "title": "Errors"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProfileOut": {
        "description": "Профиль ассетов: статический (``asset_profiles.yaml``) или динамический (ADR 0025).",
        "properties": {
          "clue_type": {
            "title": "Clue Type",
            "type": "string"
          },
          "domains": {
            "items": {
              "enum": [
                "music",
                "film"
              ],
              "type": "string"
            },
            "title": "Domains",
            "type": "array"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Почему отклонён динамический профиль: profile.invalid, profile.unknown_clue_type, profile.hash_mismatch, profile.limit_reached, profile.params_too_large",
            "title": "Error Code"
          },
          "origin": {
            "enum": [
              "static",
              "dynamic"
            ],
            "title": "Origin",
            "type": "string"
          },
          "params_hash": {
            "title": "Params Hash",
            "type": "string"
          },
          "profile_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null у динамического профиля (в наборах и AssetsReady — dyn_<16 hex хэша>)",
            "title": "Profile Key"
          },
          "sets": {
            "$ref": "#/components/schemas/ProfileSets"
          },
          "status": {
            "enum": [
              "active",
              "backfilling",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "clue_type",
          "profile_key",
          "params_hash",
          "origin",
          "status",
          "sets"
        ],
        "title": "ProfileOut",
        "type": "object"
      },
      "ProfileSets": {
        "description": "Сколько наборов профиля в каком состоянии.",
        "properties": {
          "failed": {
            "minimum": 0.0,
            "title": "Failed",
            "type": "integer"
          },
          "pending": {
            "minimum": 0.0,
            "title": "Pending",
            "type": "integer"
          },
          "ready": {
            "minimum": 0.0,
            "title": "Ready",
            "type": "integer"
          }
        },
        "required": [
          "ready",
          "pending",
          "failed"
        ],
        "title": "ProfileSets",
        "type": "object"
      },
      "RegenerateRequest": {
        "description": "Перегенерация набора.",
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "RegenerateRequest",
        "type": "object"
      },
      "ServiceMeta": {
        "description": "Сведения о сервисе.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "status"
        ],
        "title": "ServiceMeta",
        "type": "object"
      },
      "SourceKind": {
        "description": "Вид исходника (совпадает с ``source_media[].kind`` в событиях catalog).",
        "enum": [
          "audio",
          "frame",
          "poster",
          "soundtrack",
          "audio_clip",
          "text"
        ],
        "title": "SourceKind",
        "type": "string"
      },
      "SourceListItem": {
        "description": "Исходник единицы в списке админки (хвост 3a, план этапа 3b §2.5).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "origin": {
            "$ref": "#/components/schemas/SourceOrigin"
          },
          "position": {
            "description": "Порядок среди исходников вида",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Position",
            "type": "integer"
          },
          "source_media_id": {
            "format": "uuid",
            "title": "Source Media Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SourceStatus"
          }
        },
        "required": [
          "source_media_id",
          "kind",
          "position",
          "origin",
          "status",
          "created_at"
        ],
        "title": "SourceListItem",
        "type": "object"
      },
      "SourceOrigin": {
        "description": "Происхождение исходника (D6 плана этапа 3a): загрузка, TMDB, синтетический засев;\n``catalog`` — тексты загадок, одобренные модератором catalog (ADR 0024).",
        "enum": [
          "upload",
          "tmdb",
          "seed",
          "catalog"
        ],
        "title": "SourceOrigin",
        "type": "string"
      },
      "SourceOut": {
        "description": "Исходник после смены порядка и наборы, поставленные в (пере)генерацию.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/SourceOrigin"
          },
          "position": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Position",
            "type": "integer"
          },
          "scheduled_asset_set_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Scheduled Asset Set Ids",
            "type": "array"
          },
          "source_media_id": {
            "format": "uuid",
            "title": "Source Media Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SourceStatus"
          }
        },
        "required": [
          "source_media_id",
          "media_item_id",
          "kind",
          "origin",
          "position",
          "status",
          "scheduled_asset_set_ids"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "SourcePositionRequest": {
        "description": "Порядок исходника своего вида (кадры ``frame_sequence``: 1 — самый сложный).",
        "properties": {
          "position": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Position",
            "type": "integer"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "position",
          "reason"
        ],
        "title": "SourcePositionRequest",
        "type": "object"
      },
      "SourceStatus": {
        "description": "``registered`` — известен адрес; ``ready`` — нормализованная копия в хранилище.",
        "enum": [
          "registered",
          "ready",
          "failed"
        ],
        "title": "SourceStatus",
        "type": "string"
      },
      "UploadResponse": {
        "description": "Загруженный исходник и наборы, поставленные в генерацию.",
        "properties": {
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "mime": {
            "title": "Mime",
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/SourceOrigin"
          },
          "position": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Position",
            "type": "integer"
          },
          "scheduled_asset_set_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Scheduled Asset Set Ids",
            "type": "array"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "source_media_id": {
            "format": "uuid",
            "title": "Source Media Id",
            "type": "string"
          }
        },
        "required": [
          "source_media_id",
          "media_item_id",
          "kind",
          "sha256",
          "bytes",
          "mime",
          "scheduled_asset_set_ids",
          "position",
          "origin"
        ],
        "title": "UploadResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Генерация ассетов загадок по уровням, хранение в S3, подписанные ссылки, проверка UGC-изображений",
    "title": "guessverse-media_pipeline",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/v1/asset-sets": {
      "get": {
        "operationId": "admin_asset_sets_admin_v1_asset_sets_get",
        "parameters": [
          {
            "in": "query",
            "name": "media_item_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Media Item Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AssetSetItem"
                  },
                  "title": "Response Admin Asset Sets Admin V1 Asset Sets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Не аутентифицирован"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Недостаточно прав"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Некорректные данные"
          }
        },
        "summary": "Наборы ассетов единицы (для карточки в админке)",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/v1/asset-sets/{asset_set_id}/regenerate": {
      "post": {
        "operationId": "regenerate_asset_set_admin_v1_asset_sets__asset_set_id__regenerate_post",
        "parameters": [
          {
            "in": "path",
            "name": "asset_set_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Asset Set Id",
              "type": "string"
            }
          },
          {
            "description": "Обязателен. Ключ идемпотентности: 8–128 символов [A-Za-z0-9_.:-]. Повтор с тем же ключом и телом возвращает сохранённый ответ, с другим телом — 409 idempotency.key_reused.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Обязателен. Ключ идемпотентности: 8–128 символов [A-Za-z0-9_.:-]. Повтор с тем же ключом и телом возвращает сохранённый ответ, с другим телом — 409 idempotency.key_reused.",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetSetItem"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Не аутентифицирован"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Недостаточно прав"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Не найдено"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Конфликт состояния"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Ресурс больше недоступен"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Некорректные данные"
          }
        },
        "summary": "Перегенерировать набор ассетов",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/v1/profiles": {
      "get": {
        "operationId": "admin_profiles_admin_v1_profiles_get",
        "parameters": [
          {
            "in": "query",
            "name": "clue_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Clue Type"
            }
          },
          {
            "in": "query",
            "name": "params_hash",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Params Hash"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProfileOut"
                  },
                  "title": "Response Admin Profiles Admin V1 Profiles Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
