{
  "components": {
    "schemas": {
      "AssetLinkRequest": {
        "description": "Запрос ссылки на уровень набора.",
        "properties": {
          "asset_set_id": {
            "format": "uuid",
            "title": "Asset Set Id",
            "type": "string"
          },
          "level": {
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Level",
            "type": "integer"
          },
          "subject": {
            "description": "Кто запрашивает (сессия игры, матч): ключ лимита выдачи. Сервис хранит только sha256-хэш значения",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\x21-\\x7e]+$",
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "asset_set_id",
          "level",
          "subject"
        ],
        "title": "AssetLinkRequest",
        "type": "object"
      },
      "AssetLinkResponse": {
        "description": "Подписанная ссылка.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "level": {
            "title": "Level",
            "type": "integer"
          },
          "mime": {
            "title": "Mime",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expires_at",
          "mime",
          "level"
        ],
        "title": "AssetLinkResponse",
        "type": "object"
      },
      "AssetSetItem": {
        "description": "Набор ассетов.",
        "properties": {
          "asset_set_id": {
            "format": "uuid",
            "title": "Asset Set Id",
            "type": "string"
          },
          "clue_type": {
            "title": "Clue Type",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "levels_count": {
            "title": "Levels Count",
            "type": "integer"
          },
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "params_hash": {
            "title": "Params Hash",
            "type": "string"
          },
          "profile_key": {
            "title": "Profile Key",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "asset_set_id",
          "media_item_id",
          "clue_type",
          "profile_key",
          "params_hash",
          "status",
          "levels_count",
          "generation",
          "error_code"
        ],
        "title": "AssetSetItem",
        "type": "object"
      },
      "Body_upload_source_admin_v1_sources_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "Файл исходника",
            "title": "File",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "media_item_id",
          "kind",
          "reason",
          "file"
        ],
        "title": "Body_upload_source_admin_v1_sources_post",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 Problem Details — тело любого ответа-ошибки сервиса (для OpenAPI).\n\nAttributes:\n    type: URN проблемы ``urn:guessverse:problem:<code>``.\n    title: Человекочитаемый заголовок.\n    status: HTTP-статус.\n    code: Машинный код ошибки — на него опираются клиенты.\n    detail: Пояснение.\n    correlation_id: Идентификатор цепочки запроса (для поиска в логах).\n    details: Безопасные для клиента подробности (``AppError.details``).\n    errors: Ошибки валидации полей запроса.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ошибки валидации: loc, msg, type",
            "title": "Errors"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RegenerateRequest": {
        "description": "Перегенерация набора.",
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "RegenerateRequest",
        "type": "object"
      },
      "ServiceMeta": {
        "description": "Сведения о сервисе.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "status"
        ],
        "title": "ServiceMeta",
        "type": "object"
      },
      "SourceKind": {
        "description": "Вид исходника (совпадает с ``source_media[].kind`` в событиях catalog).",
        "enum": [
          "audio",
          "frame",
          "poster"
        ],
        "title": "SourceKind",
        "type": "string"
      },
      "UploadResponse": {
        "description": "Загруженный исходник и наборы, поставленные в генерацию.",
        "properties": {
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "media_item_id": {
            "format": "uuid",
            "title": "Media Item Id",
            "type": "string"
          },
          "mime": {
            "title": "Mime",
            "type": "string"
          },
          "scheduled_asset_set_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Scheduled Asset Set Ids",
            "type": "array"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "source_media_id": {
            "format": "uuid",
            "title": "Source Media Id",
            "type": "string"
          }
        },
        "required": [
          "source_media_id",
          "media_item_id",
          "kind",
          "sha256",
          "bytes",
          "mime",
          "scheduled_asset_set_ids"
        ],
        "title": "UploadResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Генерация ассетов загадок по уровням, хранение в S3, подписанные ссылки, проверка UGC-изображений",
