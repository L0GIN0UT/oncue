                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Конфликт состояния"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Ресурс больше недоступен"
          },
          "422": {
