# СГЕНЕРИРОВАНО `gv gen` из infra/services.toml — не редактировать вручную.
# Проверка: uv run lint-imports

[importlinter]
root_packages =
    gv_core
    gv_db
    gv_messaging
    gv_observability
    gv_service
    gv_auth
    gv_flags
    gv_testkit
    identity_service
    catalog_service
    media_pipeline_service
    game_service
    match_service
    rating_service
    collections_service
    library_service
    integrations_service
    progression_service
    payments_service
    social_service
    notifications_service
    bff_web_service
    admin_service
include_external_packages = True

[importlinter:contract:core-is-pure]
name = gv_core не зависит от инфраструктуры и других библиотек
type = forbidden
source_modules = gv_core
forbidden_modules =
    gv_db
    gv_messaging
    gv_observability
    gv_service
    gv_auth
    gv_flags
    gv_testkit
    sqlalchemy
    fastapi
    pydantic
    redis

[importlinter:contract:libs-do-not-import-services]
name = Библиотеки не импортируют сервисы
type = forbidden
source_modules =
    gv_core
    gv_db
    gv_messaging
    gv_observability
    gv_service
    gv_auth
    gv_flags
    gv_testkit
forbidden_modules =
    identity_service
    catalog_service
    media_pipeline_service
    game_service
    match_service
    rating_service
    collections_service
    library_service
    integrations_service
    progression_service
    payments_service
    social_service
    notifications_service
    bff_web_service
    admin_service

[importlinter:contract:services-independent]
name = Сервисы не импортируют друг друга
type = independence
modules =
    identity_service
    catalog_service
    media_pipeline_service
    game_service
    match_service
    rating_service
    collections_service
    library_service
    integrations_service
    progression_service
    payments_service
    social_service
    notifications_service
    bff_web_service
    admin_service

[importlinter:contract:identity-layers]
name = identity: слои domain ← application ← infrastructure | api
type = layers
layers =
    identity_service.api | identity_service.infrastructure
    identity_service.application
    identity_service.domain

[importlinter:contract:identity-domain-pure]
name = identity: домен без фреймворков и инфраструктуры
type = forbidden
source_modules = identity_service.domain
forbidden_modules =
    fastapi
    sqlalchemy
    redis
    aiokafka
    aio_pika
    httpx
    gv_db
    gv_messaging
    gv_service
    gv_observability

